<?xml version="1.0" encoding="utf-8"?>
<!--
  The restore source set is part of the build, so it is declared here instead
  of inherited. Without <clear/>, NuGet also reads the machine- and
  user-level configs, and a developer's private feed or a mirror on another
  host can serve the same package id from different content; packages.lock.json
  then fails RestoreLockedMode on one machine and not the other. Clearing the
  inherited sources and naming nuget.org leaves exactly one source.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
