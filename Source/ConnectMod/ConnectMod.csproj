<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>7dtd-fastconnect</AssemblyName>
    <RootNamespace>SdtdConnect</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)../../dist/7dtd-fastconnect/</OutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- The shipped dll carries a debug directory naming the pdb by its
         absolute build path, so two checkouts of one commit produced
         different bytes. No symbols are shipped (scripts/stage_mod.sh stages
         the dll and ModInfo.xml only), so build with none. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <!-- Second line of defence against the checkout path reaching the
         assembly: ContinuousIntegrationBuild pins the source root to a fixed
         /_/ prefix and PathMap strips this tree's absolute prefix from
         anything the compiler still records, so the same commit built from
         two directories compiles to the same bytes. -->
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <!-- packages.lock.json records the resolved graph with a content hash
         each package, so restore cannot drift to a different reference
         assembly set. Bump it with:
           dotnet restore Source/ConnectMod/ConnectMod.csproj \
             -p:RestorePackagesWithLockFile=true -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- The SDK pulls this in implicitly for net48 on a non-Windows host, at
         whatever version it defaults to, so the build fetched a different
         reference assembly set as the SDK moved. Declare the one version. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup>
    <GameRoot Condition="'$(GameRoot)' == ''">$(HOME)/.local/share/Steam/steamapps/common/7 Days To Die</GameRoot>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">$(GameRoot)/7DaysToDie_Data/Managed</GameManagedDir>
    <HarmonyPath Condition="'$(HarmonyPath)' == ''">$(GameRoot)/Mods/0_TFP_Harmony/0Harmony.dll</HarmonyPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LogLibrary">
      <HintPath>$(GameManagedDir)/LogLibrary.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(GameManagedDir)/com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
